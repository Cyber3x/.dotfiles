{
  "permissions": {
    "defaultMode": "default",
    "ask": [
      "Bash(rm *)",
      "Bash(sed *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(mv *)",
      "Bash(dd *)",
      "Bash(truncate *)",
      "Bash(shred *)",
      "Bash(unlink *)",
      "Bash(docker stop *)",
      "Bash(docker rm *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf $HOME)",
      "Bash(chmod 777 *)",
      "Bash(chown -R *)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * | bash)",
      "Bash(wget * | sh)",
      "Bash(eval *)",
      "Bash(sudo rm -rf *)",
      "Bash(mkfs *)",
      "Bash(dd if=* of=/dev/*)"
    ]
  },
  "model": "opus",
  "enabledPlugins": {
    "phpstorm-plugin@phpstorm-marketplace": true
  },
  "extraKnownMarketplaces": {
    "phpstorm-marketplace": {
      "source": {
        "source": "github",
        "repo": "jetbrains/phpstorm-claude-marketplace"
      }
    }
  },
  "effortLevel": "high",
  "verbose": true,
  "showThinkingSummaries": true
}
